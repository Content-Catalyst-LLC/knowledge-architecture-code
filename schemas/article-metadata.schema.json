{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Architecture Article Metadata",
  "type": "object",
  "required": ["title", "slug", "series", "status"],
  "properties": {
    "title": { "type": "string" },
    "slug": { "type": "string" },
    "series": { "type": "string" },
    "status": { "type": "string" },
    "domain": { "type": "string" },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
