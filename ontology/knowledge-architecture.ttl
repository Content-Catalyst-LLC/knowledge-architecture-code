@prefix ka: <https://sustainablecatalyst.com/ontology/knowledge-architecture#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ka:KnowledgeArchitecture a rdfs:Class ;
  rdfs:label "Knowledge Architecture" ;
  rdfs:comment "The design of intellectual systems that organize concepts, relationships, research pathways, taxonomies, ontologies, metadata, and knowledge infrastructure." .

ka:TaxonomyDesign a rdfs:Class ;
  rdfs:label "Taxonomy Design" .

ka:OntologyModeling a rdfs:Class ;
  rdfs:label "Ontology Modeling" .

ka:KnowledgeGraph a rdfs:Class ;
  rdfs:label "Knowledge Graph" .
